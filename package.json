{
  "name": "flintrail",
  "version": "1.3.0",
  "description": "The fastest browser MCP server: drive a real Chrome live, record a flow once, replay it in milliseconds without an LLM, or skip the UI entirely and replay the site's own API calls.",
  "type": "module",
  "bin": {
    "flintrail": "bin/supervise.cjs"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "extension",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-extension.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "bench": "npm run build && npm --prefix bench install --no-audit --no-fund && node bench/bench.mjs && node bench/chart.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:extension": "npm run build && node scripts/build-extension.mjs --zip",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser",
    "automation",
    "playwright",
    "cdp",
    "chrome",
    "ai-agent",
    "record-replay",
    "claude"
  ],
  "author": "Soflution Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soflutionltd/flintrail.git"
  },
  "homepage": "https://github.com/Soflutionltd/flintrail#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright-core": "1.64.1",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "bugs": {
    "url": "https://github.com/Soflutionltd/flintrail/issues"
  }
}
